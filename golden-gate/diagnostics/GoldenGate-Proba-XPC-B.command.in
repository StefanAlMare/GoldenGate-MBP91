#!/bin/sh
printf '%s\n' 'Șablon A/B. Completează profilul local înainte de utilizare.' >&2
exit 78
# GG_BEGIN_SOURCE
#!/usr/bin/python3
"""Run the author's signed anonymous NSXPC reply test twice on Golden B."""
import hashlib
import io
import os
from pathlib import Path
import re
import runpy
import shlex
import subprocess
import sys
import tarfile
import tempfile

HERE = Path(__file__).resolve().parent
OUTPUT = HERE.parents[2] / "outputs"
BIN = OUTPUT / "GoldenGate-XPC-Bin"
TRANSPORT = runpy.run_path(str(HERE / "GoldenGate-Test-Cache-A-pe-B.command"))
SSH, HOST = TRANSPORT["SSH"], TRANSPORT["HOST"]
GATE = runpy.run_path(str(HERE / "GoldenGate-Finder-B.command"))["GATE"]
FILES = {
    "xpcreply.x86_64": "154f7ffb15d742a6dae76f07a7846f0c4da91ece65348b1d4e0006874260cc73",
    "xpcreply.arm64e": "aef3d12637b41fdab3ddf2a808ca88f1f30c2511fa8916dab5889e764c9389df",
}
SUMS = "".join(f"{digest}  {name}\n" for name, digest in FILES.items()).encode("ascii")
STAGE = re.compile(r"/private/tmp/GG-XPC-B\.[0-9A-Za-z]{8}")

TEST = r"""
use strict;
use warnings;
use POSIX qw(:sys_wait_h setpgid _exit);
use Time::HiRes qw(clock_gettime CLOCK_MONOTONIC sleep);
$|=1;
my $stage = shift;
my @rows = ("size {1280.5,800.25} size", "pair first second", "mixed m1 2.75 m2 -42",
    "seven s1 s2 s3 s4 s5 s6 s7", "nine n1 n2 n3 n4 n5 n6 n7 n8 n9");
my @expected = (@rows, @rows, 'done');

sub test_client {
    my ($tag, @cmd) = @_;
    my $start = clock_gettime(CLOCK_MONOTONIC);
    my $pid = fork;
    die "fork: $!\n" unless defined $pid;
    if (!$pid) {
        setpgid(0,0) == 0 or _exit(126);
        open STDOUT, '>', "$stage/$tag.out" or _exit(126);
        open STDERR, '>', "$stage/$tag.err" or _exit(126);
        my @keys = grep { /^(?:HAO_|DYLD_)/ } keys %ENV;
        delete @ENV{@keys};
        $ENV{TMPDIR} = "$stage/";
        $ENV{STDBUF1} = 'L';
        $ENV{HAO_NO_AOT} = '1' if $tag eq 'arm64e';
        exec { $cmd[0] } @cmd or do { print STDERR "exec $cmd[0]: $!\n"; _exit(127) };
    }
    print "GG_XPC_START client=$tag pid=$pid\n";
    my ($status,$timeout);
    while (1) {
        my $p = waitpid($pid,WNOHANG);
        if ($p == $pid) { $status = $?; last }
        die "waitpid: $!\n" if $p < 0;
        if (clock_gettime(CLOCK_MONOTONIC) - $start >= 30) {
            $timeout=1;
            kill 'KILL', -$pid;
            kill 'KILL', $pid;
            waitpid($pid,0) == $pid or die "waitpid: $!\n";
            $status = $?;
            last;
        }
        sleep 0.05;
    }
    my $rc = ($status & 127) ? 128 + ($status & 127) : $status >> 8;
    my @got;
    for my $stream (qw(out err)) {
        next unless open my $fh, '<', "$stage/$tag.$stream";
        my $count = 0;
        while (<$fh>) {
            chomp; s/\r$//;
            push @got, $_ if $stream eq 'out';
            if ($count++ < 14) {
                my $row = substr($_,0,260);
                $row =~ s/[\x00-\x1f\x7f]/ /g;
                print "GG_XPC_$stream client=$tag | $row\n";
            }
        }
        close $fh;
        print "GG_XPC_TRUNCAT client=$tag stream=$stream linii=$count\n" if $count > 14;
    }
    my $match = @got == @expected;
    my $first;
    for my $i (0..$#expected) {
        if (!defined($got[$i]) || $got[$i] ne $expected[$i]) { $match=0; $first=$i+1; last }
    }
    my $ok = $match && !$timeout && $rc == 0;
    printf "GG_XPC_RESULT client=%s pid=%d rc=%d timeout=%d linii=%d egale=%d prima_diferenta=%s rezultat=%s\n",
        $tag, $pid, $rc, $timeout//0, scalar(@got), $match?1:0,
        defined($first)?$first:(@got>@expected?12:'-'), $ok?'trecut':'esuat';
    return $ok;
}
my $intel = test_client('x86_64', "$stage/xpcreply.x86_64");
my $arm = test_client('arm64e', '/usr/libexec/hao', '--', "$stage/xpcreply.arm64e");
print "GG_XPC_COMPARATIE x86_64=", $intel?'trecut':'esuat', " arm64e_HAO=", $arm?'trecut':'esuat', "\n";
exit($intel && $arm ? 0 : 3);
"""

USER_GATE = GATE + r"""
[[ $uid == 501 && $(/usr/bin/id -un) == @@GUI_USER@@ ]] || { echo 'GG_STOP Contul Golden B diferă.'; exit 2; }
"""


def checked_payload():
    if (BIN / "SHA256SUMS").read_bytes() != SUMS:
        raise ValueError("Manifestul celor două executabile diferă de cel verificat.")
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
        for name in (*FILES, "SHA256SUMS"):
            data = (BIN / name).read_bytes()
            if name in FILES and hashlib.sha256(data).hexdigest() != FILES[name]:
                raise ValueError("SHA-256 diferă pentru " + name)
            entry = tarfile.TarInfo(name)
            entry.mode = 0o700 if name in FILES else 0o600
            entry.size = len(data)
            tar.addfile(entry, io.BytesIO(data))
    return buf.getvalue()


def remote():
    inner = USER_GATE + r"""
[[ $(/bin/launchctl managername) == Aqua && $(/usr/bin/stat -f '%u:%Lp' "$1") == 501:700 ]] || {
    echo 'GG_STOP Sesiunea Aqua sau directorul temporar diferă.'; exit 2; }
cd "$1" || exit 2
/usr/bin/shasum -a 256 -c SHA256SUMS >/dev/null || { echo 'GG_STOP Verificarea binarelor a eșuat.'; exit 2; }
for f in xpcreply.x86_64 xpcreply.arm64e; do
    /usr/bin/codesign --verify --strict "$f" || { echo "GG_STOP Semnătură nevalidă: $f"; exit 2; }
done
echo 'GG_XPC_MEDIU Golden B 26B131 | Aqua UID 501 | executabilele și semnăturile verificate'
ulimit -f 128 || exit 2
exec /usr/bin/perl -e """ + shlex.quote(TEST) + ' -- "$1"'
    return USER_GATE + r"""
set -eu -o pipefail
umask 077
stage=$(/usr/bin/mktemp -d /private/tmp/GG-XPC-B.XXXXXXXX)
trap '/bin/rm -rf -- "$stage"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
/bin/stty onlcr 2>/dev/null || true
echo "GG_STAGE $stage"
for ((i=0; i<90; i++)); do
    [[ ! -f "$stage/.transmis" ]] || break
    /bin/sleep 1
done
[[ -f "$stage/.transmis" ]] || { echo 'GG_STOP Transfer expirat.'; exit 3; }
read -r sum rest < <(/usr/bin/shasum -a 256 "$stage/SHA256SUMS")
[[ "$sum" == """ + hashlib.sha256(SUMS).hexdigest() + r""" ]] || { echo 'GG_STOP Manifest nevalid.'; exit 2; }
if [[ $(/bin/launchctl managername) == Aqua ]]; then
    runner=(/bin/bash)
else
    runner=(/usr/bin/sudo -p 'Parola de administrator pe Golden pentru accesul în sesiunea Aqua:
' -- /bin/launchctl asuser "$uid" /usr/bin/sudo -n -H -u "#$uid" -- /bin/bash)
fi
"${runner[@]}" -c """ + shlex.quote(inner) + ' golden-xpc "$stage"'


def mux(socket, command):
    return SSH + ["-T", "-S", socket, "-o", "BatchMode=yes", "-o", "ProxyCommand=/usr/bin/false",
                  HOST, "/bin/bash -c " + shlex.quote(command)]


def transact(socket, payload, report):
    cmd = "/bin/bash -c " + shlex.quote(remote())
    master = subprocess.Popen(SSH + ["-M", "-S", socket, "-tt", HOST, cmd], stdout=subprocess.PIPE)
    stage = None
    was_sent = False
    try:
        for raw in master.stdout:
            line = raw.decode("utf-8", "replace").rstrip("\r\n")
            print(line, flush=True)
            if line.startswith("GG_STAGE "):
                path = line[len("GG_STAGE "):]
                if stage or not STAGE.fullmatch(path):
                    raise ValueError("Director temporar neașteptat pe B.")
                stage = path
                upload = (f'[[ -d {stage} && ! -L {stage} && $(/usr/bin/stat -f "%u:%Lp" {stage}) == 501:700 ]]'
                          f' && /usr/bin/tar -xzf - -C {stage} && : > {stage}/.transmis')
                subprocess.run(mux(socket, upload), input=payload, timeout=60, check=True)
                was_sent = True
            elif line.startswith("GG_"):
                print(line, file=report, flush=True)
        rc = master.wait()
        if rc == 0 and not was_sent:
            raise ValueError("Transfer neconfirmat.")
        return rc
    finally:
        if stage and (master.poll() is None or master.returncode == 255):
            cleanup = USER_GATE + f'\nif [[ -d {stage} && ! -L {stage} && $(/usr/bin/stat -f "%u:%Lp" {stage}) == 501:700 ]]; then /bin/rm -rf -- {stage}; fi'
            try:
                result = subprocess.run(mux(socket, cleanup), timeout=8, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if result.returncode == 255:
                    retry = SSH + ["-T", "-o", "BatchMode=yes", HOST, "/bin/bash -c " + shlex.quote(cleanup)]
                    subprocess.run(retry, timeout=10, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except (OSError, subprocess.TimeoutExpired):
                pass
        if master.poll() is None:
            master.terminate()
            try:
                master.wait(timeout=5)
            except subprocess.TimeoutExpired:
                master.kill()
                master.wait()
        master.stdout.close()


def main():
    if len(sys.argv) != 1:
        sys.exit("Lansează comanda fără argumente.")
    os.umask(0o077)
    folder = Path(tempfile.mkdtemp(prefix="Finder-XPC-B-", dir=OUTPUT))
    path = folder / "raport.txt"
    print("Raport pe iMac:", path, flush=True)
    with path.open("x") as report, tempfile.TemporaryDirectory(prefix="ggxpc-", dir="/private/tmp") as tmp:
        try:
            payload = checked_payload()
            rc = transact(str(Path(tmp) / "s"), payload, report)
        except (OSError, ValueError, subprocess.SubprocessError, KeyboardInterrupt) as exc:
            print("Proba s-a întrerupt.", str(exc), file=sys.stderr)
            print("GG_STOP Proba s-a întrerupt.", str(exc), file=report)
            rc = 1
        print("Cod de ieșire:", rc, file=report)
        return rc


if __name__ == "__main__":
    sys.exit(main())
